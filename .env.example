# Configuración de Firebase (Project Settings > General > Tus apps > SDK setup and configuration)
# Estas variables son públicas por diseño (van al bundle del cliente) — la seguridad real
# la dan las reglas de Firestore (firestore.rules), no estas claves.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Sentry (monitoreo de errores). El DSN no es secreto — solo permite ENVIAR eventos,
# no leerlos — pero igual va por variable de entorno para no hardcodearlo en el código.
NEXT_PUBLIC_SENTRY_DSN=

# OpenAI (transcripción y armado de listas por voz). ESTA SÍ ES SECRETA DE VERDAD —
# a diferencia de las de arriba, nunca lleva el prefijo NEXT_PUBLIC_ porque permite
# gastar dinero real. Solo se usa del lado del servidor (src/app/api/voz/route.ts).
OPENAI_API_KEY=
